# Copy this file to .env (same folder) and fill in your own key.
# .env is in .gitignore - never commit it.

# LLM Reasoning Engine (backend/llm_engine.py). Any OpenAI-compatible API works.
# Default: Groq (free key from https://console.groq.com -> API Keys).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1500

# Set to false to force the rule-based engine even when a key is set.
LLM_ENABLED=true

# OpenAI instead of Groq:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
