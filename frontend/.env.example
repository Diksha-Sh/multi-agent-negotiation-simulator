# Backend API address used by src/services/api.js.
# Copy this file to .env.local (ignored by git) to change it.
VITE_API_URL=http://127.0.0.1:8000

# Supabase Authentication & PostgreSQL Database
# Get these free credentials from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
